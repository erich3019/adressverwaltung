# ============================================================
# Umgebungsvariablen für das Next.js-Frontend
# Diese Datei wird NICHT ins Git-Repository eingecheckt!
# ============================================================

# URL des ASP.NET Core Backends (für Browser-seitige Aufrufe)
NEXT_PUBLIC_API_URL=http://localhost:5000

# URL des Backends für server-seitige Aufrufe (in Docker: interner Service-Name)
# Lokal: gleich wie NEXT_PUBLIC_API_URL
INTERNAL_API_URL=http://localhost:5000

# ============================================================
# NextAuth.js Konfiguration
# ============================================================

# Öffentliche URL der Next.js-App (ohne abschliessenden Slash)
NEXTAUTH_URL=http://localhost:3000

# Geheimer Schlüssel für JWT-Signierung und Session-Verschlüsselung.
# Selbst generieren mit: openssl rand -base64 32
NEXTAUTH_SECRET=ERSETZE_MICH_MIT_ECHTEM_SECRET

# ============================================================
# Google OAuth (optional)
# Erstelle ein OAuth 2.0-Client unter https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ============================================================
GOOGLE_CLIENT_ID=ERSETZE_MICH_MIT_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=ERSETZE_MICH_MIT_GOOGLE_CLIENT_SECRET
