{
  "Jwt": {
    "Issuer": "AdressverwaltungApi",
    "Audience": "AdressverwaltungFrontend",
    "ExpiresInHours": 8
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=adressverwaltung;Username=adressverwaltung_app"
  },
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "dein-smtp-benutzer@example.com",
    "Password": "dein-smtp-passwort",
    "FromAddress": "noreply@example.com",
    "SenderName": "Adressverwaltung",
    "EnableSsl": "true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
