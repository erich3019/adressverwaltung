# Kopieren nach env/backend.env und Werte ersetzen.
# Das Passwort muss mit POSTGRES_PASSWORD in env/db.env übereinstimmen.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=adressverwaltung;Username=postgres;Password=ERSETZEN
# Mindestens 32 Zeichen, z.B. openssl rand -base64 48
Jwt__Key=ERSETZEN
SmtpSettings__Username=user@example.com
SmtpSettings__Password=ERSETZEN
# Optional: Passwort des Admin-Benutzers beim ersten Start mit leerer Datenbank.
# Ohne diesen Wert erzeugt das Backend ein Zufallspasswort und schreibt es ins Log.
# Seed__AdminPassword=
